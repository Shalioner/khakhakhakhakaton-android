# Secrets and local configuration
.env
*.key
*.pem

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Logs and temporary files
*.log
tmp/
temp/

# Generic build output
build/
dist/
out/
target/
bin/
obj/

# Dependencies and caches
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.gradle/

# Received files are generated during demonstrations
examples/output/*
!examples/output/.gitkeep

# Keep large demo media outside Git unless intentionally included
artifacts/demo/*.mp4
artifacts/demo/*.mov
artifacts/demo/*.mkv
artifacts/demo/*.wav


# Models and caches (fetched by tools/fetch_models.py)
.cache/
src/android/libs/
*.gguf
*.onnx

# generated audio (regenerate: tools/tts_lines.ps1 + tools/make_synthetic.py)
testdata/smoke/*.wav
testdata/dev/*.wav
testdata/test/*.wav
# live-наборы (regenerate: tools/build_live_sets.sh; лицензии источников — testdata/README.md)
testdata/live_dev/*.wav
testdata/live_test/*.wav
