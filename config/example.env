# Параметры конвейера (значения по умолчанию из core/PipelineConfig.kt и sherpa/EngineConfig).
# Приложению конфиг не нужен — параметры зашиты в APK; этот файл документирует их и опции bench.
# Секретов в проекте нет (сеть не используется).

# Реплики
PAUSE_SPLIT_MS=1000          # разрыв реплики одного спикера при паузе больше (bench: --pause-split-ms)
VAD_EXTEND_END_MS=1000       # продление конца реплики до границы VAD
VAD_EXTEND_START_MS=400
MIN_SPEAKER_TOTAL_MS=1500    # спикер с меньшей суммарной речью растворяется (bench: --min-speaker-ms)

# Диаризация
CLUSTER_THRESHOLD=0.5        # bench: --cluster-threshold; NUM_CLUSTERS=-1 — автоопределение
NUM_CLUSTERS=-1

# ASR
MAX_CHUNK_MS=25000
CHUNK_PAD_MS=200

# LLM
LLM_BUDGET_FRACTION=0.3      # бюджет времени LLM на файл как доля длительности аудио
