   "end_ms": 29088,
   "text": "Да."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 29093,
   "end_ms": 31533,
   "text": "Тогда записываем решение в протокол."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 31473,
   "end_ms": 32513,
   "text": "Единогласно."
