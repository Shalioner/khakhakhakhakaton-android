 "transcript": [
  {
   "speaker_id": "speaker_1",
   "start_ms": 300,
   "end_ms": 2320,
   "text": "Я могу помурлыкать, у меня хороший голос."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 2509,
   "end_ms": 3389,
   "text": "Единогласно."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 4382,
   "end_ms": 9002,
   "text": "В прошлом месяце дежурства часто пропускали, особенно по выходным."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 8940,
   "end_ms": 9420,
   "text": "Хорошо."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 10217,
   "end_ms": 12737,
   "text": "Я могу помурлыкать, у меня хороший голос."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 13481,
   "end_ms": 14681,
   "text": "Ну, это справедливо."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 15699,
   "end_ms": 18799,
   "text": "Кто отвечает за закупку корма на следующий месяц?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 19903,
   "end_ms": 23243,
   "text": "Меню беру на себя: рыба, курица и немного сливок."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 23715,
   "end_ms": 24955,
   "text": "Извините, продолжайте."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 25103,
   "end_ms": 26923,
   "text": "Никто и не говорит, что это ты."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 28034,
   "end_ms": 29974,
   "text": "Ну, это справедливо."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 30494,
   "end_ms": 31034,
   "text": "Понятно."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 32212,
   "end_ms": 33532,
   "text": "Сколько это будет стоить?"
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 33426,
   "end_ms": 35746,
   "text": "Ага, хорошая мысль."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 35936,
   "end_ms": 37556,
   "text": "Дороговато, но выбора у нас нет."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 38506,
   "end_ms": 42486,
   "text": "Спасибо всем за участие, заседание объявляю закрытым."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 43075,
   "end_ms": 45235,
   "text": "Отличная идея, давайте так и сделаем."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 45819,
   "end_ms": 48179,
   "text": "Отличная идея, давайте так и сделаем."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 48692,
   "end_ms": 51052,
   "text": "Кто отвечает за закупку корма на следующий месяц?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 50989,
   "end_ms": 53149,
   "text": "Дороговато, но выбора у нас нет."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 54316,
   "end_ms": 57576,
   "text": "Нужно выбрать место, меню и программу."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 57978,
   "end_ms": 61278,
   "text": "В прошлом месяце дежурства часто пропускали, особенно по выходным."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 61549,
   "end_ms": 62929,
   "text": "А если пойдёт дождь?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 62797,
   "end_ms": 64377,
   "text": "Никто и не говорит, что это ты."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 64241,
   "end_ms": 69801,
   "text": "У меня есть замечание по бюджету: расходы на игрушки выросли почти вдвое."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 70259,
   "end_ms": 72899,
   "text": "Меню беру на себя: рыба, курица и немного сливок."
  },
  {
   "speaker_id": "speaker_3",
