{
 "transcript": [
  {
   "speaker_id": "speaker_1",
   "start_ms": 300,
   "end_ms": 2900,
   "text": "Курск, улица Ленина, дом семьдесят."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 3061,
   "end_ms": 5841,
   "text": "Липецк, проспект Победы, дом пятнадцать."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 6635,
   "end_ms": 9835,
   "text": "улица Советская, дом сто восемнадцать."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 9777,
   "end_ms": 12657,
   "text": "Калуга, улица Кирова, дом один."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 12881,
   "end_ms": 16121,
   "text": "Тверь, проспект Чайковского, дом одиннадцать."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 16406,
   "end_ms": 19746,
   "text": "Воронеж, проспект Революции, дом тридцать два."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 19417,
   "end_ms": 24177,
   "text": "Орехово-Зуево, улица Ленина, дом двадцать два."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 24517,
   "end_ms": 28197,
   "text": "Балашиха, проспект Ленина, дом двадцать семь."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 28505,
   "end_ms": 31445,
   "text": "Коломна, улица Ленина, дом одинадцать."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 32280,
   "end_ms": 36260,
   "text": "Сергиев Посад, проспект Красной Армии, дом сто тридцать три."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 36180,
   "end_ms": 40460,
   "text": "Мытищи, улица Карла Маркса, дом двенадцать."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 41327,
   "end_ms": 44667,
   "text": "Красногорск, Ильинский бульвар, дом два."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 44899,
   "end_ms": 47199,
   "text": "Люберцы, улица Ленина, дом три."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 47634,
   "end_ms": 50294,
   "text": "Подольск, улица Кирова, дом сорок семь."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 50497,
   "end_ms": 53897,
   "text": "Королев, проспект Космонавтов, дом восемнадцать."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 54780,
   "end_ms": 58180,
   "text": "Химки, улица Юбилейный проспект, дом тридцать шесть."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 58613,
   "end_ms": 61553,
   "text": "Дзержинский, улица Ленина, дом двадцать два."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 61737,
   "end_ms": 64417,
   "text": "Реутов, улица Победы, дом шестнадцать."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 64661,
   "end_ms": 68341,
   "text": "Домодедово, улица Каширское шоссе, дом три."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 68251,
   "end_ms": 71571,
   "text": "Железнодорожный, улица Ленина, дом тридцать восемь."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 72259,
   "end_ms": 74819,
   "text": "Серпухов, улица Центральная, дом девять."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 75589,
   "end_ms": 77589,
   "text": "Чехов, улица Ленина, дом четыре."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 78066,
   "end_ms": 81246,
   "text": "Пушкино, улица Московский проспект, дом одиннадцать."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 81998,
   "end_ms": 84698,
   "text": "Раменское, улица Ленина, дом два."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 85438,
   "end_ms": 87738,
   "text": "Видное, улица Школьная, дом пять."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 88191,
   "end_ms": 91371,
   "text": "Егорьевск, улица Советская, дом восемнадцать."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 91596,
   "end_ms": 94276,
   "text": "Жуковский, улица Гагарина, дом восемь."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 94504,
   "end_ms": 97004,
   "text": "Лобня, улица Ленина, дом двенадцать."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 97642,
   "end_ms": 99822,
   "text": "Фрязино, проспект Мира, дом три."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 100273,
   "end_ms": 103773,
   "text": "Долгопрудный, улица Лихачевский проспект, дом пятнадцать."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 104482,
   "end_ms": 108562,
   "text": "Электросталь, улица Победы, дом шесть."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 108524,
   "end_ms": 111884,
   "text": "Ногинск, улица Советская, дом девять."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 112436,
   "end_ms": 116396,
   "text": "Орехово-Зуево, улица Ленина, дом пятьдесят пять"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 116962,
   "end_ms": 120382,
   "text": "Павловский Посад, улица Ленина, дом сорок два."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 121226,
   "end_ms": 125246,
   "text": "Шатура, улица Интернациональная, дом десять."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 126010,
   "end_ms": 129490,
   "text": "Клин, улица Ленина, дом четырнадцать."
  }
 ]
}