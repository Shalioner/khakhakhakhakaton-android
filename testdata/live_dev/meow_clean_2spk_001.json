  {
   "speaker_id": "speaker_2",
   "start_ms": 3012,
   "end_ms": 5592,
   "text": "Сколько котов сейчас живёт в нашем доме?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 5766,
   "end_ms": 6966,
   "text": "А если пойдёт дождь?"
