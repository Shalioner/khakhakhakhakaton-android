  {
   "speaker_id": "speaker_2",
   "start_ms": 31267,
   "end_ms": 31587,
   "text": "Угу."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 31988,
   "end_ms": 34508,
   "text": "Отличная идея, давайте так и сделаем."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 34881,
   "end_ms": 38561,
   "text": "Меню беру на себя: рыба, курица и немного сливок."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 39967,
   "end_ms": 41667,
   "text": "Извините, продолжайте."
