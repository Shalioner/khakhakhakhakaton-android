  {
   "speaker_id": "speaker_2",
   "start_ms": 23463,
   "end_ms": 24503,
   "text": "Единогласно."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 25998,
   "end_ms": 28978,
   "text": "Нужно выбрать место, меню и программу."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 30015,
   "end_ms": 31955,
   "text": "Извините, продолжайте."
