 "transcript": [
  {
   "speaker_id": "speaker_1",
   "start_ms": 300,
   "end_ms": 2500,
   "text": "Тогда записываем решение в протокол."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 3304,
   "end_ms": 6984,
   "text": "Меню беру на себя: рыба, курица и немного сливок."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 8343,
   "end_ms": 11023,
   "text": "Нужно выбрать место, меню и программу."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 12443,
   "end_ms": 14543,
   "text": "Никто и не говорит, что это ты."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 15744,
   "end_ms": 16944,
   "text": "Возражения есть?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 18368,
   "end_ms": 21168,
   "text": "Отличная идея, давайте так и сделаем."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 21918,
   "end_ms": 26638,
   "text": "Соседи с пятого этажа жалуются, что кто-то бегает по лестнице после полуночи."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 27668,
   "end_ms": 31648,
   "text": "Спасибо всем за участие, заседание объявляю закрытым."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 32085,
   "end_ms": 33465,
   "text": "А если пойдёт дождь?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 34693,
   "end_ms": 37273,
   "text": "Сколько котов сейчас живёт в нашем доме?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 38418,
   "end_ms": 39318,
   "text": "Единогласно."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 40762,
   "end_ms": 42602,
   "text": "А гости тоже получают корм?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 43644,
   "end_ms": 44844,
   "text": "А если пойдёт дождь?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 44793,
   "end_ms": 48093,
   "text": "Кто отвечает за закупку корма на следующий месяц?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 47832,
   "end_ms": 49732,
   "text": "Никто и не говорит, что это ты."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 50770,
   "end_ms": 53730,
   "text": "Я могу помурлыкать, у меня хороший голос."
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 54773,
   "end_ms": 57793,
   "text": "Я могу помурлыкать, у меня хороший голос."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 58703,
   "end_ms": 61223,
   "text": "Отличная идея, давайте так и сделаем."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 62636,
   "end_ms": 62956,
   "text": "Угу."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 62923,
   "end_ms": 66223,
   "text": "Меню беру на себя: рыба, курица и немного сливок."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 65763,
   "end_ms": 70343,
   "text": "В прошлом месяце дежурства часто пропускали, особенно по выходным."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 71035,
   "end_ms": 72415,
   "text": "Сколько это будет стоить?"
  },
  {
   "speaker_id": "speaker_3",
   "start_ms": 73218,
   "end_ms": 74898,
   "text": "Ага, хорошая мысль."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 75337,
   "end_ms": 77677,
   "text": "Дороговато, но выбора у нас нет."
  },
  {
   "speaker_id": "speaker_1",
