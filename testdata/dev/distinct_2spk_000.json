 "transcript": [
  {
   "speaker_id": "speaker_1",
   "start_ms": 300,
   "end_ms": 6000,
   "text": "У меня есть замечание по бюджету: расходы на игрушки выросли почти вдвое."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 6537,
   "end_ms": 10217,
   "text": "Меню беру на себя: рыба, курица и немного сливок."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 10093,
   "end_ms": 12473,
   "text": "Никто и не говорит, что это ты."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 12532,
   "end_ms": 12852,
   "text": "Угу."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 13555,
   "end_ms": 16915,
   "text": "Я могу помурлыкать, у меня хороший голос."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 18264,
   "end_ms": 20364,
   "text": "Никто и не говорит, что это ты."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 20132,
   "end_ms": 21992,
   "text": "Ага, хорошая мысль."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 22031,
   "end_ms": 23911,
   "text": "Извините, продолжайте."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 24544,
   "end_ms": 28284,
   "text": "Кто отвечает за закупку корма на следующий месяц?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 29446,
   "end_ms": 30626,
   "text": "Возражения есть?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 31475,
   "end_ms": 32155,
   "text": "Понятно."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 33436,
   "end_ms": 37416,
   "text": "Спасибо всем за участие, заседание объявляю закрытым."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 38723,
   "end_ms": 43243,
   "text": "Спасибо всем за участие, заседание объявляю закрытым."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 43774,
   "end_ms": 48794,
   "text": "У меня есть замечание по бюджету: расходы на игрушки выросли почти вдвое."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 50015,
   "end_ms": 51155,
   "text": "Единогласно."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 51841,
   "end_ms": 53361,
   "text": "Сколько это будет стоить?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 53748,
   "end_ms": 57928,
   "text": "Меню беру на себя: рыба, курица и немного сливок."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 58035,
   "end_ms": 60375,
   "text": "Дороговато, но выбора у нас нет."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 60461,
   "end_ms": 62601,
   "text": "Извините, продолжайте."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 64098,
   "end_ms": 64678,
   "text": "Хорошо."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 64993,
   "end_ms": 67913,
   "text": "Сколько котов сейчас живёт в нашем доме?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 68305,
   "end_ms": 68905,
   "text": "Понятно."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 69296,
   "end_ms": 71016,
   "text": "Сколько это будет стоить?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 71702,
   "end_ms": 73342,
   "text": "Ага, хорошая мысль."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 74301,
   "end_ms": 74981,
   "text": "Хорошо."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 75017,
   "end_ms": 79597,
   "text": "В прошлом месяце дежурства часто пропускали, особенно по выходным."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 80522,
   "end_ms": 83162,
   "text": "Дороговато, но выбора у нас нет."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 84153,
   "end_ms": 86793,
   "text": "Нужно выбрать место, меню и программу."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 88196,
   "end_ms": 88556,
   "text": "Угу."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 89799,
   "end_ms": 91639,
   "text": "А гости тоже получают корм?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 92888,
   "end_ms": 95608,
   "text": "Тогда записываем решение в протокол."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 96907,
   "end_ms": 100207,
   "text": "Кто отвечает за закупку корма на следующий месяц?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 100630,
   "end_ms": 102730,
   "text": "А гости тоже получают корм?"
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 103473,
   "end_ms": 104473,
   "text": "Единогласно."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 105483,
   "end_ms": 108463,
   "text": "Нужно выбрать место, меню и программу."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 108859,
   "end_ms": 110179,
   "text": "А если пойдёт дождь?"
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 110025,
   "end_ms": 115985,
   "text": "Соседи с пятого этажа жалуются, что кто-то бегает по лестнице после полуночи."
  },
  {
   "speaker_id": "speaker_2",
   "start_ms": 117073,
   "end_ms": 119873,
   "text": "Отличная идея, давайте так и сделаем."
  },
  {
   "speaker_id": "speaker_1",
   "start_ms": 119902,
   "end_ms": 121422,
   "text": "А если пойдёт дождь?"
  }
